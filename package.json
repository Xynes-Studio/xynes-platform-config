{
  "name": "xynes-platform-config",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "migrate": "drizzle-kit migrate",
    "seed": "bun run scripts/seedRoutes.ts",
    "seed:routes": "bun run scripts/seedRoutes.ts",
    "gen:docs": "sh -c 'bun --env-file=\"${XYNES_ENV_FILE:-.env.dev}\" run scripts/generate-docs.ts'"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.2",
    "hono": "^4.13.8",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bun": "^1.4.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.70.0"
  }
}
